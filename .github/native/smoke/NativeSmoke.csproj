<Project Sdk="Microsoft.NET.Sdk">
  <!-- Test dymny bibliotek z workflow native.yml — nie jest częścią aplikacji. Ten sam pakiet .NET co WS.Scribe (1.13.8). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>NativeSmoke</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="org.k2fsa.sherpa.onnx" Version="1.13.8" />
  </ItemGroup>
</Project>
